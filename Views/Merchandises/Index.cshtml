@model IEnumerable<Zoolirante_Open_Minded.Models.Merchandise>
@{
    ViewData["Title"] = "Index";
}
@inject IHttpContextAccessor HttpContextAccessor



@{
    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var fullName = HttpContextAccessor.HttpContext.Session.GetString("FullName");
    var role = HttpContextAccessor.HttpContext.Session.GetString("Role");
}
<h1>Merchandise</h1>

<form method="get" class="filters-wrap">
    <div class="filter-slab">
        <div class="row g-3 align-items-center">
          
            <div class="col-12 col-md-4">
                <select name="category"
                        class="form-select"
                        asp-items="@(ViewBag.CategoryList as IEnumerable<SelectListItem>)"
                        onchange="this.form.submit()">
                    <option value="">All Categories</option>
                </select>
            </div>

        
            <div class="col-12 col-md-6">
                <input name="searchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search merchandise..." />
            </div>


            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-warning w-100 filter-btn">
                    Search
   
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</form>

@if (userId != null && role == "Admin")
{
    <p><a class="btn btn-warning" asp-action="Create">Create New</a></p>
    
}




@if (userId != null)
{
    @if (TempData["CartMessage"] is string pageMsg)
    {
        <div class="alert alert-success">@pageMsg</div>
    }
    <div class="text-end mb-3">
        <a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="Index">View Cart</a>
    </div>

}


<style>
    .card-img-top {
        height: 180px;
        object-fit: cover;
    }

    .text-truncate-2 {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
</style>

@if (!Model.Any())
{
    <div class="alert alert-warning">No merchandise found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img class="card-img-top" src="@item.ImageUrl" alt="@item.Name" />

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <h6 class="card-title mb-0 text-truncate">@item.Name</h6>
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                <span class="badge text-bg-light border">@item.Category</span>
                            }
                        </div>

                        <p class="card-text small text-muted text-truncate-2 flex-grow-1">
                            @item.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold">@item.Price.ToString("C")</span>
                            <span class="badge text-bg-secondary">Stock: @item.Stock</span>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0">
                        <div class="d-grid gap-2">
                            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.ProductId">Details</a>
                            @if (userId != null && role == "Admin")
                            {
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.ProductId">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                                </div>
                            }
                            @if (item.Stock <= 0)
                            {
                                <div class="text-danger small mt-2">Out of stock</div>
                            }
                            else
                            {
                                @if (userId != null)
                                {
                                <form asp-controller="Merchandises" asp-action="AddToCart" method="post" class="d-flex align-items-center gap-2 mt-2">
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <input type="number" name="qty" value="1" min="1" max="@item.Stock"
                                           class="form-control form-control-sm w-auto" />
                                    <button type="submit" class="btn btn-sm btn-primary">Add to cart</button>
                                    @Html.AntiForgeryToken()
                                    </form>
                                }
                                else
                                {
                                    <a class="btn btn-warning" asp-controller="Users" asp-action="Login">Please login to buy item</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

