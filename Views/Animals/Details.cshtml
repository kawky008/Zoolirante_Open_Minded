@model Zoolirante_Open_Minded.Models.Animal

@{
    ViewData["Title"] = "Details";
}

<div class="card mb-3" style="max-width:1000px;">
    <div class="row g-0">
        <div class="col-md-6">
            <img class="card-img" style="height:500px;" src="@Model.ImageUrl" alt="@Model.Name">
        </div>
        <div class="col-md-6">
            <div class="card-body">
                <div class="row align-items-center mb-4">
                    <h5 class="col card-title">@Html.DisplayFor(modelItem => Model.Name)</h5>
                    <div class="col-auto mb-2">
                        <!-- From Uiverse.io by barisdogansutcu -->
                        <input type="checkbox" class="favorite-input" id="favorite-@Model.AnimalId">
                        <label for="favorite-@Model.AnimalId" class="favorite-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-heart">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            <div class="action">
                                <span class="option-1">Add to Favorites</span>
                                <span class="option-2">Added to Favorites</span>
                            </div>
                        </label>
                    </div>
                </div>
                <p class="card-text mb-1">Species: @Html.DisplayFor(modelItem => Model.Species)</p>
                <p class="card-text mb-1">Conservation Status: @Html.DisplayFor(modelItem => Model.ConservationStatus)</p>
                <p class="card-text mb-1">Region: @Html.DisplayFor(modelItem => Model.Region)</p>
            </div>
        </div>
    </div>
</div>

<div>
    <h4>Animal</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Species)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Species)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Region)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Region)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ConservationStatus)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ConservationStatus)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Habitat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Habitat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImageUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExhibitLocation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ExhibitLocation)
        </dd>
    </dl>
</div>
