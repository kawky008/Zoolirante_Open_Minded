@model IEnumerable<Zoolirante_Open_Minded.Models.Animal>

@{
    ViewData["Title"] = "Index";
}

<form asp-controller="Animals" asp-action="Index">
    <div class="row mb-4">
        <div class="col-3">
            <input class="form-control" type="text" name="searchName" id="searchName" placeholder="Search animal..." value="@ViewBag.searchName" />
        </div>
        <div class="col-3">
            <select id="searchSpecies" name="searchSpecies" class="form-control" asp-items="ViewBag.speciesList">
                <option value="">All Species</option>
            </select>
        </div>
        <div class="col-3">
            <select id="searchConservation" name="searchConservation" class="form-control" asp-items="ViewBag.conservation">
                <option value="">All Conservation Status</option>
            </select>
        </div>
        <div class="col-2">
            <select id="searchRegion" name="searchRegion" class="form-control" asp-items="ViewBag.regionList">
                <option value="">All Region</option>
            </select>
        </div>
    </div>
    <div class="row mb-4">
        <div class ="col-3">
            <button class=" btn btn-warning w-100 mb-2">Search</button>
       </div>
        </div>
</form>

<hr />
@if (!Model.Any())
{
    <div class="alert alert-warning">No Animal found.</div>
}
else
{
    <div class="row g-4 mx-0">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <a asp-action="Details" asp-route-id="@item.AnimalId" class="text-decoration-none text-dark d-block h-100">
                        <img class="card-img-top " style="width:100%; height:370px;" src="@item.ImageUrl" alt="@item.Name">
                        <div class="card-body">
                            <h5 class="card-title mb-2">@Html.DisplayFor(modelItem => item.Name)</h5>
                            <p class="card-text mb-1">Species: @Html.DisplayFor(modelItem => item.Species)</p>
                            <p class="card-text">Conservation Status: @Html.DisplayFor(modelItem => item.ConservationStatus)</p>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>

}
