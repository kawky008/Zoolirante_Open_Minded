@model IEnumerable<Zoolirante_Open_Minded.Models.Animal>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form asp-controller="Animals" asp-action="Index">
    <div class="row">
        <div class="col-5">
            <label id="searchName">Search Animals</label>
            <input class="form-control" type="text" name="searchName" id="searchName" placeholder="Search animal..." value="@ViewBag.searchName" />
        </div>
        <div class="col-3">
            <label id="searchSpecies">Species</label>
            <select id="searchSpecies" name="searchSpecies" class="form-control" asp-items="ViewBag.speciesList">
                <option value="">All Species</option>
            </select>
        </div>
        <div class="col-3">
            <label id="searchConservation">Conservation Status</label>
            <select id="searchConservation" name="searchConservation" class="form-control" asp-items="ViewBag.conservation">
                <option value="">All Conservation Status</option>
            </select>
        </div>

        <div class="col-1 mt-4">
            <button class="btn btn-outline-info" type="submit">Search</button>
        </div>
       
    </div>
</form>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Species)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Region)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConservationStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Habitat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExhibitLocation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Species)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Region)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConservationStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Habitat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExhibitLocation)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AnimalId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AnimalId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AnimalId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
