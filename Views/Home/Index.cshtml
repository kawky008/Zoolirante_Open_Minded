@{
    ViewData["Title"] = "Home Page";
}

<div class="row h-100 g-4 mb-4">
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display list of today's events</p>
                <p>Able to jump to clicked event</p>
            </div>            
        </div>
    </div>
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display list of this week's events</p>
                <p>Able to jump to clicked event</p>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display account & membership link</p>
            </div>
        </div>
    </div>
</div>
<img src="/images/sample_map.png" style="width:50%; height:auto; display:block; margin:0 auto;" />
