@{
    ViewData["Title"] = "Home Page";
}

<div class="row h-100 g-4 mb-4">
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display list of today's events</p>
                <p>Able to jump to clicked event</p>
            </div>            
        </div>
    </div>
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display list of this week's events</p>
                <p>Able to jump to clicked event</p>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card" style="width: 25rem; height: 10rem;">
            <div class="card-body">
                <p class="card-text">Display account & membership link</p>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Map using Leaflet.js -->
<div class="d-flex justify-content-center mb-4">
    <div class="text-center map-card">
        <h2 style="color: #d17a09; margin-top:1rem; margin-bottom: 1rem;">Map of the zoo</h2>
        <div id="map" class="map mx-auto"></div>
    </div>
</div>

<script>
    const map = L.map('map', {crs: L.CRS.Simple, zoomSnap: 0.2, zoomDelta: 0.5, minZoom: -1, maxZoom: 1});
    const bounds = [[0, 0], [800, 1500]];
    const image = L.imageOverlay('/images/sample_map.png', bounds).addTo(map);
    map.fitBounds(bounds);

    // Icon class for Pin
    var Pin = L.Icon.extend({
        options: {
            iconSize:     [50, 45], // size of the icon
            iconAnchor:   [0, 0], // point of the icon which will correspond to marker's location
            popupAnchor:  [25, -2] // point from which the popup should open relative to the iconAnchor
        }
    })

    var orangePin = new Pin({iconUrl: 'images/orange_pin.png'}),
        bluePin = new Pin({iconUrl: 'images/blue_pin.png'});

    // display orange pins
    L.marker([600, 300], {icon: orangePin}).addTo(map).bindPopup("Bear exhibit");
    L.marker([570, 850], {icon: orangePin}).addTo(map).bindPopup("Savanna exhibit");
    L.marker([250, 150], {icon: orangePin}).addTo(map).bindPopup("Primate exhibit");
    L.marker([200, 850], {icon: orangePin}).addTo(map).bindPopup("Bird exhibit");

    // display blue pins
    L.marker([550, 450], {icon: bluePin}).addTo(map).bindPopup("Rest area");
    L.marker([200, 1200], {icon: bluePin}).addTo(map).bindPopup("Zoo entrance");
    L.marker([500, 1100], {icon: bluePin}).addTo(map).bindPopup("Restaurants");

</script>

