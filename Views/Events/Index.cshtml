@model IEnumerable<Zoolirante_Open_Minded.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 m-0">Upcoming Events</h1>

    <a href="#eventList" class="btn btn-primary btn-sm">View Upcoming Events</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        There are no upcoming events right now. Please check back later.
    </div>
}
else
{
<div id="eventList" class="row g-3">
    @foreach (var e in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-1">@e.Title</h5>
                    <div class="small text-muted mb-2">
                        @e.StartTime.ToString("ddd, dd MMM yyyy h:mm tt") • @e.Location
                    </div>
                    <p class="card-text">@e.Description</p>
                    <a asp-action="Details" asp-route-id="@e.EventId" class="btn btn-outline-primary w-100">
                        View
                    </a>
                </div>
            </div>
        </div>
    }
</div>
}


