@model Zoolirante_Open_Minded.Models.User


@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Login" method="post">
           
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Please enter your email"/>
                <span asp-validation-for="Email" class="text-danger"></span>
               
            </div>
            <div class="form-group">
                <label asp-for="PasswordHash" class="control-label"></label>
                <input asp-for="PasswordHash" class="form-control" placeholder="Please enter your password"/>
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
                
            </div>
            <a class="text-black-50" asp-controller="Users" asp-action="Reset">Forgot password?</a>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-danger">Logon</button>
            </div>
            
        </form>
    </div>
    
   
</div>
<div class="col-5">
    <a asp-action="Create" class="btn btn-warning mt-3">You don't have an account? Create one</a>
</div>