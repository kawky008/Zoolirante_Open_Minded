@model IEnumerable<Zoolirante_Open_Minded.Models.Order>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role") ?? "";
    bool isManager = !string.Equals(role, "Customer", StringComparison.OrdinalIgnoreCase);
}


@{
    ViewData["Title"] = "Index";
}

<h1>Tracking Orders</h1>

<form asp-action="Index" method="get">
    <div class="row">
        <div class="col-3">
            <input name="search" placeholder="Search..." class="form-control" />
        </div>
        <div class="col-3">
            <button type="submit" class="btn btn-warning">Search</button>
        </div>

    </div>

</form>
<p>
    <a class="mt-3" asp-action="Create">Create New</a>
</p>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>
                Customer Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PickupDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PickupLocation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>Customer Info</th>
            <th></th>

        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.User.FullName)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Items)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PickupDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PickupLocation.PickupLocationId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Email)
            </td>
                <td>

                    @if (isManager)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-bs-toggle="modal"
                                data-bs-target="#cust-@item.OrderId">
                            Customer info
                        </button>

                        <!-- Modal lives inside the table cell to avoid invalid HTML inside <tbody> -->
                        <div class="modal fade" id="cust-@item.OrderId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Customer details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        @{
                                            var u = item.User;

                                            string Try(string name)
                                            => u?.GetType().GetProperty(name) != null
                                            ? Convert.ToString(u.GetType().GetProperty(name)!.GetValue(u)) ?? ""
                                            : "";

                                            // Required basics
                                            var email = u?.Email ?? "";

                                            // Single phone (show if your model has one; otherwise "—")
                                            var phone = Try("Phone");
                                            if (string.IsNullOrWhiteSpace(phone)) phone = Try("PhoneNumber");
                                            if (string.IsNullOrWhiteSpace(phone)) phone = Try("Mobile");
                                            if (string.IsNullOrWhiteSpace(phone)) phone = Try("ContactNumber");
                                            if (string.IsNullOrWhiteSpace(phone)) phone = Try("Telephone");
                                            if (string.IsNullOrWhiteSpace(phone)) phone = Try("PhoneNo");

                                            string ShowOrDash(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
                                        }

                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Full name</dt>
                                            <dd class="col-sm-8">@ShowOrDash(item.User?.FullName ?? "")</dd>

                                            <dt class="col-sm-4">Email</dt>
                                            <dd class="col-sm-8">
                                                @if (!string.IsNullOrWhiteSpace(email))
                                                {
                                                    <a href="mailto:@email">@email</a>
                                                }
                                                else
                                                {
                                                    @:—
                                                }
                                            </dd>

                                            <dt class="col-sm-4">Phone</dt>
                                            <dd class="col-sm-8">@ShowOrDash(phone)</dd>
                                        </dl>

                                        <div class="alert alert-warning small mt-3 mb-0">
                                            Managers can view contact info only. Sensitive fields are never shown.
                                        </div>
                                    </div>



                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrderId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
