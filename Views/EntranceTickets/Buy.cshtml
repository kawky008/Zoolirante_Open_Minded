@model Zoolirante_Open_Minded.Models.EntranceTicket
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Guest";
    ViewData["Title"] = "Buy Entrance Ticket";
}

<style>
    /* Orange panel with dark text for contrast */
    .visit-panel {
        background: #fff3cd; /* light orange */
        border: 1px solid #ffc107;
        border-radius: 12px;
    }

        .visit-panel .card-header {
            background: #ffe69c;
            border-bottom: 1px solid #ffc107;
            color: #111827; /* dark text */
            font-weight: 700;
        }

        .visit-panel .card-body,
        .visit-panel label,
        .visit-panel .form-control,
        .visit-panel .form-select {
            color: #111827;
        }
</style>

<h2 class="mb-3">Buy Entrance Ticket</h2>
<p class="mb-2">Logged in as: <strong>@fullName</strong></p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info">@TempData["Info"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Book / Cancel UI (posts to SaveVisitTime) -->
<div class="card visit-panel shadow-sm mb-4">
    <div class="card-header">Choose your visit time</div>
    <div class="card-body">
        <form id="visitForm" asp-action="SaveVisitTime" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()

            <div class="col-md-4">
                <label class="form-label">Date</label>
                <input type="date"
                       name="date"
                       class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Time range</label>
                <select name="range" class="form-select">
                    <option>09:00-11:00</option>
                    <option>11:00-13:00</option>
                    <option>13:00-15:00</option>
                    <option>15:00-17:00</option>
                </select>
            </div>


@{
    
    var allowed = ViewBag.AllowedPayments as string[] ?? new[] { "Visa", "MasterCard", "PayPal" };
    var userPaymentMethod = ViewBag.UserPaymentMethod as string ?? "";
    bool paymentMethodValid = (ViewBag.PaymentMethodValid as bool?) ?? true;
}

<h2>Buy Entrance Ticket</h2>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-success flex-fill">Book</button>
                <button type="button" id="cancelVisitBtn" class="btn btn-outline-danger flex-fill">Cancel</button>
            </div>
        </form>


        <small class="text-muted d-block mt-2">
            Booking saves your chosen time; payment is handled below.
        </small>

        <div id="visitAlertArea" class="mt-2"></div>
    </div>
</div>

<!-- Purchase form (matches your master branch) -->
<form asp-action="Buy" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="UserId" value="@userId" />

    <div class="mb-3">
        <label asp-for="Type" class="form-label">Ticket Type</label>
        <select asp-for="Type" class="form-control">
            <option value="Adult" selected>Adult ($30)</option>
            <option value="Child">Child ($20)</option>
        </select>

        <div class="mt-2">
            <small class="text-muted">Allowed payment methods for this ticket:</small>
            <div class="mt-1" id="allowedBadges">
                @foreach (var p in allowed)
                {
                    <span class="badge rounded-pill bg-light text-dark border me-1">@p</span>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(userPaymentMethod))
        {
            <div class="mt-2">
                <small>
                    Using your saved method:
                    <span class="badge @(paymentMethodValid ? "bg-success" : "bg-warning text-dark")">
                        @userPaymentMethod
                    </span>
                </small>

                @if (!paymentMethodValid)
                {
                    <div class="alert alert-warning mt-2 mb-0 p-2">
                        Your saved payment method isn’t valid for the selected ticket.
                        <a asp-controller="Users"
                           asp-action="EditPayment"
                           class="btn btn-sm btn-outline-secondary ms-2">Change payment method</a>
                    </div>
                }
            </div>
        }

        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <input asp-for="Details" type="hidden" />

    <button type="submit" class="btn btn-primary">Buy Ticket</button>
</form>

<script>
    // UI-only cancel: clear inputs and show a friendly message
    document.getElementById('cancelVisitBtn')?.addEventListener('click', function () {
      const form = document.getElementById('visitForm');
      if (!form) return;

      form.reset();

      const dateInput = form.querySelector('input[name="date"]');
      if (dateInput && !dateInput.value) {
        const today = new Date().toISOString().substring(0, 10);
        dateInput.value = today;
      }

      const area = document.getElementById('visitAlertArea');
      if (area) {
        area.innerHTML =
          '<div class="alert alert-secondary alert-dismissible fade show" role="alert">' +
            'Selection cleared.' +
            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
          '</div>';
      }
    });
</script>

